# 이 파일을 terraform.tfvars로 복사한 뒤 내 환경에 맞게 바꿉니다.
# terraform.tfvars는 Git에 올리지 않습니다.
aws_region          = "ap-northeast-2"
project_name        = "school-jobs-demo"
admin_ssh_cidr      = "203.0.113.10/32" # 내 공인 IPv4/32로 교체
ssh_public_key_path = "~/.ssh/id_ed25519.pub" # SSH 공개키 경로

# DB 비밀번호는 이 파일에 적지 않고 TF_VAR_db_password로 전달합니다.
